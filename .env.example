# Copy to .env and replace the placeholders before running or building.
DB_SERVER=localhost,1433
DB_DATABASE=gateway_dev
DB_UID=gateway_dev_user
DB_PWD=replace-with-database-password
# DB_DRIVER=ODBC Driver 18 for SQL Server

COPILOT_API_URL=https://copilot.example.invalid/v1/chat/completions
TOKEN_API_URL=https://iam.example.invalid/token
APP_ID=com.example.gateway
UPSTREAM_AUTH_TYPE=dynamic_token
ZJ_API_URL=https://zj.example.invalid/v1/chat/completions
ZJ_API_KEY=replace-with-upstream-key

LOCAL_PORT=9899
UPSTREAM_TIMEOUT=300
TOKEN_CACHE_TTL=240
DEFAULT_API_KEY=replace-with-unique-gateway-key
SEED_ACCOUNTS_JSON=[]
# Example: SEED_ACCOUNTS_JSON='[["demo_account", "Demo account"]]'

# Keep empty during source development.
UPDATE_SHARE_PATH=
UPDATE_CHECK_INTERVAL_HOURS=24
